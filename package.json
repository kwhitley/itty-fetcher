{
  "name": "itty-fetcher",
  "version": "1.0.3",
  "type": "module",
  "description": "An tiny wrapper to make native Fetch even simpler and more powerful.",
  "main": "./fetcher.js",
  "module": "./fetcher.mjs",
  "types": "./fetcher.d.ts",
  "exports": {
    ".": {
      "import": "./dist/fetcher.mjs",
      "types": "./dist/fetcher.d.ts",
      "require": "./dist/fetcher.cjs"
    }
  },
  "scripts": {
    "dev": "bun test --watch --coverage",
    "lint": "itty lint",
    "verify": "echo 'verifying module...' && bun run build && bun test",
    "prerelease": "bun run verify",
    "build": "itty lint && itty build --snippet=fetcher --hybrid",
    "release": "itty publish --tag --push --patch --src=dist",
    "release:next": "itty publish --tag --push --type=next --src=dist"
  },
  "keywords": [
    "fetch",
    "api",
    "composable",
    "tiny",
    "simple",
    "json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwhitley/itty-fetcher.git"
  },
  "author": "Kevin R. Whitley <krwhitley@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kwhitley/itty-fetcher/issues"
  },
  "devDependencies": {
    "@types/bun": "^1.2.17",
    "itty-packager": "^1.0.7"
  }
}
