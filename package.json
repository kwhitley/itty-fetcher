{
  "name": "itty-fetcher",
  "version": "0.9.4-next.1",
  "type": "module",
  "description": "Tiny wrapper around native fetch to remove boilerplate from your own API fetching code.",
  "main": "./fetcher.js",
  "module": "./fetcher.mjs",
  "types": "./fetcher.d.ts",
  "exports": {
    ".": {
      "import": "./fetcher.mjs",
      "require": "./fetcher.js",
      "types": "./fetcher.d.ts"
    }
  },
  "scripts": {
    "dev": "bun test --watch --coverage",
    "lint": "bun eslint src",
    "verify": "echo 'verifying module...' && bun run build && bun test",
    "prerelease": "bun run verify",
    "prerelease:next": "bun run verify",
    "prebuild": "rm -rf dist && mkdir dist",
    "build": "rollup -c && cp LICENSE dist/ && bun readme-inject.mjs",
    "release": "release --tag --push --patch --src=dist",
    "release:next": "release --tag --push --type=next --src=dist"
  },
  "keywords": [
    "fetch",
    "api",
    "helper",
    "tiny",
    "json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwhitley/itty-fetcher.git"
  },
  "author": "Kevin R. Whitley <krwhitley@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kwhitley/itty-fetcher/issues"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/bun": "^1.2.17",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "rollup": "^4.28.1",
    "rollup-plugin-bundle-size": "^1.0.3",
    "typescript": "^5.7.2",
    "yarn-release": "^1.10.6"
  }
}
